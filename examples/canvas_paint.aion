// Interactive Canvas & Pixel Paint Example (Web/WASM, Android, iOS)
#S_color:str="#38BDF8"
#S_cmds:list<map<str,any>>=[
  {op:"rect",   x:12,  y:12,  w:326, h:72, r:12, fill:"#1E293B", stroke:"#334155", sw:2},
  {op:"circle", cx:52, cy:48, r:20,  fill:"#2563EB", stroke:"#93C5FD", sw:2},
  {op:"arc",    cx:110, cy:48, r:18, start:0, sweep:260, stroke:"#10B981", sw:4},
  {op:"line",   x1:150, y1:62, x2:210, y2:30, stroke:"#F59E0B", sw:3},
  {op:"text",   x:225, y:53, text:"AION Canvas", size:14, color:"#F8FAFC"},
  {op:"pixels", size:4, pts:[[20,104,"#38BDF8"],[28,104,"#818CF8"],[36,104,"#F472B6"],[44,104,"#34D399"]]}
]

#N_root:ROOT[20,20,100%,100%,#0B1120]{#N_col}
#N_col:FLEX[v,s,c,14]{#N_hdr,#N_canvas,#N_bar}

#N_hdr:FLEX[h,c,c,8]{#N_ic_hdr,#N_title}
#N_ic_hdr:ICON[22,#38BDF8]{"edit"}
#N_title:TXT[20,700,#F8FAFC]{"AION Pixel & Vector Canvas"}

#N_canvas:CANVAS[350,360,#0F172A,#S_cmds] @tap->PUSH(#S_cmds,{op:"pixel",x:item.x,y:item.y,color:#S_color,size:6}) @drag->PUSH(#S_cmds,{op:"pixel",x:item.x,y:item.y,color:#S_color,size:6})

#N_bar:FLEX[h,c,c,10]{#N_c1,#N_c2,#N_c3,#N_clr}
#N_c1:BTN[44,40,8,#38BDF8]{#N_c1_t} @tap->#S_color="#38BDF8"
#N_c1_t:TXT[12,700,#0B1120]{"A"}
#N_c2:BTN[44,40,8,#F472B6]{#N_c2_t} @tap->#S_color="#F472B6"
#N_c2_t:TXT[12,700,#0B1120]{"R"}
#N_c3:BTN[44,40,8,#34D399]{#N_c3_t} @tap->#S_color="#34D399"
#N_c3_t:TXT[12,700,#0B1120]{"V"}
#N_clr:BTN[110,40,8,#DC2626]{#N_clr_row} @tap->#S_cmds=[]
#N_clr_row:FLEX[h,c,c,6]{#N_clr_ic,#N_clr_t}
#N_clr_ic:ICON[16,#FFFFFF]{"trash"}
#N_clr_t:TXT[13,600,#FFFFFF]{"Limpiar"}
